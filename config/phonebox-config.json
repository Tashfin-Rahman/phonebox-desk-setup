  "rules": [
    {
      "id": "r-ai",
      "name": "AI needs me → AI work",
      "enabled": true,
      "when": "session-waiting",
      "then": "goto",
      "whileActive": true,
      "priority": 8,
      "page": "ai"
    },
    {
      "id": "r-game",
      "name": "Game running → Gaming",
      "enabled": false,
      "when": "process-running",
      "then": "goto",
      "whileActive": true,
      "priority": 6,
      "match": "cs2|FC25|FC26",
      "page": "gaming",
      "forSec": 10
    },
    {
      "id": "r-study",
      "name": "Study hours → Study",
      "enabled": true,
      "when": "time",
      "then": "goto",
      "whileActive": true,
      "priority": 4,
      "match": "19:00-22:00",
      "days": "sun,mon,tue,wed,thu",
      "page": "study"
    },
    {
      "id": "r-cpu",
      "name": "CPU working hard",
      "enabled": true,
      "when": "cpu-above",
      "then": "notify",
      "whileActive": true,
      "priority": 3,
      "value": 90,
      "text": "PC is working hard: {detail}",
      "level": "warn",
      "forSec": 30,
      "cooldownMin": 15
    },
    {
      "id": "r-ping",
      "name": "Internet slow",
      "enabled": true,
      "when": "ping-high",
      "then": "notify",
      "whileActive": true,
      "priority": 3,
      "text": "Internet is slow: {detail}",
      "level": "warn",
      "cooldownMin": 10
    },
    {
      "id": "r-afk",
      "name": "Away 10 min → Night",
      "enabled": true,
      "when": "idle",
      "then": "goto",
      "whileActive": true,
      "priority": 2,
      "value": 10,
      "page": "night"
    },
    {
      "id": "r-late",
      "name": "Late night → Night",
      "enabled": true,
      "when": "time",
      "then": "goto",
      "whileActive": true,
      "priority": 2,
      "match": "23:30-07:00",
      "page": "night"
    }
  ]
}
